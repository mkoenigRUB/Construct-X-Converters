<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.construct-x</groupId>
    <artifactId>construct-x-converters-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Construct-X Converters (Parent)</name>
    <description>Converters from domain file formats (GAEB XML, ...) to Construct-X ontology TTL data, exposed as a web service.</description>

    <modules>
        <module>core</module>
        <module>web</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jena.version>4.10.0</jena.version>
        <junit.version>5.10.2</junit.version>
        <spring-boot.version>3.5.3</spring-boot.version>
        <!-- byte-buddy-agent jar for preloading the Mockito agent (attach is blocked on this machine) -->
        <!-- 8.3 short path: the umlaut in the user profile breaks the surefire fork (cmd.exe encoding) -->
        <byte-buddy-agent.jar>${settings.localRepository}/net/bytebuddy/byte-buddy-agent/1.17.6/byte-buddy-agent-1.17.6.jar</byte-buddy-agent.jar>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM for the web module -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Apache Jena for RDF/TTL -->
            <dependency>
                <groupId>org.apache.jena</groupId>
                <artifactId>apache-jena-libs</artifactId>
                <version>${jena.version}</version>
                <type>pom</type>
            </dependency>
            <!-- Core converter library -->
            <dependency>
                <groupId>org.construct-x</groupId>
                <artifactId>construct-x-converters-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- JUnit 5 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <!-- Preload the Mockito/ByteBuddy agent: dynamic self-attach is blocked on this machine (Windows attach access denied) -->
                        <argLine>-Dfile.encoding=UTF-8 -javaagent:${byte-buddy-agent.jar}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
